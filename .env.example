# Set these privately in Vercel. Never commit real values.
APP_ORIGIN=http://localhost:3000
# Optional comma-separated production aliases that are also allowed to submit forms.
APP_ALLOWED_ORIGINS=

# Neon/Postgres values are injected by `neon env pull` or a local branch credential.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Neon Object Storage / legacy compatibility values. Keep server-only.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
FAMILY_MATERIALS_BUCKET=family-materials

# Legacy Supabase compatibility retained for existing scripts and imports.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Child-facing AI stays disabled until an appropriate provider agreement is in place.
AI_PROVIDER=disabled
# Optional HTTPS gateway implementing the documented JSON contract.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_MODEL=
AI_GATEWAY_APPROVED_FOR_CHILDREN=false
# Dormant Gemini adapter only. No application route invokes it.
GEMINI_API_KEY=
GEMINI_MODEL=

# Family Tutor login. Set real values only in protected environment settings.
FAMILY_LOGIN_USERNAME=
FAMILY_LOGIN_PASSWORD=

# Retained only for an optional future Google-login migration.
FAMILY_GOOGLE_EMAIL=
